# ─── WaSender Credentials ───────────────────────────────────────────
# Get this from your WaSender dashboard → API Access Token
WASENDER_API_TOKEN=your_wasender_api_token_here

# ─── Service URL ─────────────────────────────────────────────────────
# Public URL of your Render deployment (no trailing slash)
SERVER_BASE_URL=https://dyp-admissions-bot.onrender.com

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname